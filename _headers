# Long-cache immutable, content-hashed assets
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Mirrored images (filenames are content hashes) — safe to cache hard
/_external/*
  Cache-Control: public, max-age=31536000, immutable

# Whitepaper PDFs — regenerated by GH Actions on every HTML change
/whitepapers/*.pdf
  Content-Type: application/pdf
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Disposition: inline

# Security headers for all pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://api.resend.com https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.resend.com

# CORS for the public case-study JSON feed (so heyaaronmarketing.com can fetch it)
/api/case-study.json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Cache-Control: public, max-age=300
